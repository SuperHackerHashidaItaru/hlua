#! /usr/bin/env python
# encoding: utf-8

def options(opt):
	return

def configure(conf):
	pass

def build(bld):
	# vendored upstream code, keep warning flags away from it
	bld.stlib(
		source = bld.path.ant_glob('*.c', excl = 'lua.c'),
		target = 'lua54',
		features = 'c',
		includes = '.',
		cflags = ['-w'],
	)
